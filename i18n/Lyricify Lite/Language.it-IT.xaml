    <system:String x:Key="String.Settings.PerApp.UsePlayerTrackDuration">Usa la durata fornita dal lettore</system:String>
    <system:String x:Key="String.Settings.PerApp.UsePlayerTrackDuration.Description" xml:space="preserve">Usa la durata del lettore per la ricerca dei testi e i dati dei brani.&#x000A;Alcune app aggiornano la timeline in ritardo dopo un cambio brano, riducendo la precisione e salvando durate errate nel database di gestione dei brani e testi.&#x000A;Disattiva l’opzione se riscontri questi problemi; la visualizzazione di avanzamento e durata non cambia.</system:String>
